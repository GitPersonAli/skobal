#!/usr/bin/env python3
"""Manage the skills, profiles, registry, and adapters in a Skobal repository."""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
from datetime import date
from pathlib import Path
from typing import Any, Sequence

try:
    import yaml
except ModuleNotFoundError:
    print(
        "skillctl requires PyYAML. Install it with: "
        "python3 -m pip install PyYAML",
        file=sys.stderr,
    )
    raise SystemExit(2)

from adapters import ADAPTER_NAMES, FilesystemAdapter, get_adapter


REPO_ROOT = Path(__file__).resolve().parent
SKILLS_DIR = REPO_ROOT / "skills"
PROFILES_DIR = REPO_ROOT / "profiles"
REGISTRY_PATH = REPO_ROOT / "registry.yaml"
NAME_RE = re.compile(r"^[a-z0-9]+(?:-[a-z0-9]+)*$")
VERSION_RE = re.compile(r"^\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?$")
REQUIRED_SKILL_KEYS = {"name", "version", "tags", "targets", "requires"}


class SkillctlError(Exception):
    """Expected user-facing CLI error."""


def valid_skill_name(name: object) -> bool:
    return (
        isinstance(name, str)
        and len(name) < 64
        and NAME_RE.fullmatch(name) is not None
    )


def load_yaml(path: Path) -> Any:
    try:
        return yaml.safe_load(path.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        raise SkillctlError(f"missing file: {path.relative_to(REPO_ROOT)}") from exc
    except yaml.YAMLError as exc:
        raise SkillctlError(
            f"invalid YAML in {path.relative_to(REPO_ROOT)}: {exc}"
        ) from exc


def parse_frontmatter(path: Path) -> dict[str, Any]:
    try:
        text = path.read_text(encoding="utf-8")
    except FileNotFoundError as exc:
        raise SkillctlError(f"missing file: {path.relative_to(REPO_ROOT)}") from exc

    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        raise SkillctlError(f"{path.relative_to(REPO_ROOT)}: missing YAML frontmatter")
    try:
        closing = next(
            index for index, line in enumerate(lines[1:], start=1) if line.strip() == "---"
        )
    except StopIteration as exc:
        raise SkillctlError(
            f"{path.relative_to(REPO_ROOT)}: unclosed YAML frontmatter"
        ) from exc

    try:
        metadata = yaml.safe_load("\n".join(lines[1:closing]))
    except yaml.YAMLError as exc:
        raise SkillctlError(
            f"{path.relative_to(REPO_ROOT)}: invalid frontmatter: {exc}"
        ) from exc
    if not isinstance(metadata, dict):
        raise SkillctlError(
            f"{path.relative_to(REPO_ROOT)}: frontmatter must be a mapping"
        )
    return metadata


def skill_directories() -> list[Path]:
    if not SKILLS_DIR.is_dir():
        raise SkillctlError("missing skills directory")
    return sorted(
        (
            path
            for path in SKILLS_DIR.iterdir()
            if path.is_dir() and not path.name.startswith((".", "_"))
        ),
        key=lambda path: path.name,
    )


def skill_directory(name: str) -> Path:
    if not valid_skill_name(name):
        raise SkillctlError(
            "skill name must use lowercase-hyphen format and be under 64 characters"
        )
    path = SKILLS_DIR / name
    if not path.is_dir():
        raise SkillctlError(f"unknown skill: {name}")
    return path


def skill_record(path: Path) -> dict[str, Any]:
    frontmatter = parse_frontmatter(path / "SKILL.md")
    metadata = load_yaml(path / "skill.yaml")
    if not isinstance(metadata, dict):
        raise SkillctlError(f"skills/{path.name}/skill.yaml: expected a mapping")
    return {
        "name": metadata.get("name", path.name),
        "version": metadata.get("version", ""),
        "description": frontmatter.get("description", ""),
        "tags": metadata.get("tags", []),
        "targets": metadata.get("targets", []),
    }


def validate_skill(path: Path) -> list[str]:
    errors: list[str] = []
    prefix = f"skills/{path.name}"
    try:
        frontmatter = parse_frontmatter(path / "SKILL.md")
    except SkillctlError as exc:
        errors.append(str(exc))
        frontmatter = {}

    if set(frontmatter) - {"name", "description"}:
        errors.append(f"{prefix}/SKILL.md: frontmatter supports only name and description")
    frontmatter_name = frontmatter.get("name")
    description = frontmatter.get("description")
    if not valid_skill_name(frontmatter_name):
        errors.append(
            f"{prefix}/SKILL.md: name must use lowercase-hyphen format and be "
            "under 64 characters"
        )
    elif frontmatter_name != path.name:
        errors.append(
            f"{prefix}/SKILL.md: name {frontmatter_name!r} does not match directory"
        )
    if not isinstance(description, str) or not description.strip():
        errors.append(f"{prefix}/SKILL.md: description is required")
    elif len(description) >= 1024:
        errors.append(f"{prefix}/SKILL.md: description must be under 1024 characters")
    elif "\n" in description:
        errors.append(f"{prefix}/SKILL.md: description must be one line")

    try:
        metadata = load_yaml(path / "skill.yaml")
    except SkillctlError as exc:
        errors.append(str(exc))
        metadata = {}
    if not isinstance(metadata, dict):
        errors.append(f"{prefix}/skill.yaml: expected a mapping")
        return errors

    missing = REQUIRED_SKILL_KEYS - set(metadata)
    extra = set(metadata) - REQUIRED_SKILL_KEYS
    if missing:
        errors.append(
            f"{prefix}/skill.yaml: missing keys: {', '.join(sorted(missing))}"
        )
    if extra:
        errors.append(f"{prefix}/skill.yaml: unknown keys: {', '.join(sorted(extra))}")
    if metadata.get("name") != path.name:
        errors.append(f"{prefix}/skill.yaml: name must match directory")

    version = metadata.get("version")
    if not isinstance(version, str) or not VERSION_RE.fullmatch(version):
        errors.append(f"{prefix}/skill.yaml: version must be semantic X.Y.Z")

    errors.extend(validate_string_list(metadata, "tags", prefix))
    errors.extend(validate_string_list(metadata, "targets", prefix))
    errors.extend(validate_string_list(metadata, "requires", prefix))
    targets = metadata.get("targets")
    if isinstance(targets, list):
        unknown = sorted(
            target for target in targets if isinstance(target, str) and target not in ADAPTER_NAMES
        )
        if unknown:
            errors.append(
                f"{prefix}/skill.yaml: unknown targets: {', '.join(unknown)}"
            )
    return errors


def validate_string_list(
    metadata: dict[str, Any], key: str, prefix: str
) -> list[str]:
    value = metadata.get(key)
    if not isinstance(value, list) or any(not isinstance(item, str) for item in value):
        return [f"{prefix}/skill.yaml: {key} must be a list of strings"]
    if len(value) != len(set(value)):
        return [f"{prefix}/skill.yaml: {key} must not contain duplicates"]
    return []


def registry_data() -> dict[str, list[dict[str, Any]]]:
    records = []
    for path in skill_directories():
        record = skill_record(path)
        records.append(
            {
                "name": record["name"],
                "version": record["version"],
                "description": record["description"],
                "tags": sorted(record["tags"]),
                "targets": sorted(record["targets"]),
            }
        )
    records.sort(key=lambda record: record["name"])
    return {"skills": records}


def validate_registry() -> list[str]:
    try:
        actual = load_yaml(REGISTRY_PATH)
        expected = registry_data()
    except (SkillctlError, KeyError, TypeError) as exc:
        return [str(exc)]
    if actual != expected:
        return [
            "registry.yaml is inconsistent with skills/; run './skillctl registry'"
        ]
    names = [
        item.get("name")
        for item in actual.get("skills", [])
        if isinstance(item, dict)
    ] if isinstance(actual, dict) else []
    if names != sorted(names):
        return ["registry.yaml skills must be sorted by name"]
    return []


def cmd_list(_args: argparse.Namespace) -> int:
    rows = []
    for path in skill_directories():
        record = skill_record(path)
        rows.append(
            [
                str(record["name"]),
                str(record["version"]),
                str(record["description"]),
                ", ".join(record["tags"]),
            ]
        )
    print_table(["NAME", "VERSION", "DESCRIPTION", "TAGS"], rows)
    return 0


def print_table(headers: list[str], rows: list[list[str]]) -> None:
    widths = [
        max(len(headers[index]), *(len(row[index]) for row in rows))
        for index in range(len(headers))
    ]
    print("  ".join(value.ljust(widths[index]) for index, value in enumerate(headers)))
    print("  ".join("-" * width for width in widths))
    for row in rows:
        print("  ".join(value.ljust(widths[index]) for index, value in enumerate(row)))


def cmd_new(args: argparse.Namespace) -> int:
    if not valid_skill_name(args.name):
        raise SkillctlError(
            "skill name must use lowercase-hyphen format and be under 64 characters"
        )
    destination = SKILLS_DIR / args.name
    if destination.exists():
        raise SkillctlError(f"skill already exists: {args.name}")
    template = SKILLS_DIR / "_template"
    if not template.is_dir():
        raise SkillctlError("missing skills/_template")

    replacements = {
        "{{ name }}": args.name,
        "{{name}}": args.name,
        "{{ date }}": date.today().isoformat(),
        "{{date}}": date.today().isoformat(),
    }
    for source in sorted(template.rglob("*")):
        relative = source.relative_to(template)
        target_name = relative.name.removesuffix(".tmpl")
        target = destination / relative.parent / target_name
        if source.is_dir():
            target.mkdir(parents=True, exist_ok=True)
            continue
        target.parent.mkdir(parents=True, exist_ok=True)
        content = source.read_text(encoding="utf-8")
        for placeholder, value in replacements.items():
            content = content.replace(placeholder, value)
        target.write_text(content, encoding="utf-8")
        if source.parent.name == "scripts":
            target.chmod(target.stat().st_mode | 0o111)
    print(f"Created skills/{args.name}")
    print("Run './skillctl registry' to add it to registry.yaml.")
    return 0


def cmd_validate(args: argparse.Namespace) -> int:
    paths = [skill_directory(args.name)] if args.name else skill_directories()
    errors = [error for path in paths for error in validate_skill(path)]
    errors.extend(validate_registry())
    if errors:
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
        return 1
    noun = args.name if args.name else f"{len(paths)} skills"
    print(f"Validation passed for {noun}; registry.yaml is consistent.")
    return 0


def cmd_registry(_args: argparse.Namespace) -> int:
    paths = skill_directories()
    errors = [error for path in paths for error in validate_skill(path)]
    if errors:
        for error in errors:
            print(f"ERROR: {error}", file=sys.stderr)
        return 1
    data = registry_data()
    REGISTRY_PATH.write_text(
        yaml.safe_dump(data, sort_keys=False, allow_unicode=True, width=1000),
        encoding="utf-8",
    )
    print(f"Wrote registry.yaml ({len(data['skills'])} skills).")
    return 0


def load_profile(name: str) -> dict[str, Any]:
    if not NAME_RE.fullmatch(name):
        raise SkillctlError("profile name must use lowercase-hyphen format")
    data = load_yaml(PROFILES_DIR / f"{name}.yaml")
    if not isinstance(data, dict):
        raise SkillctlError(f"profiles/{name}.yaml: expected a mapping")
    if data.get("name") != name:
        raise SkillctlError(f"profiles/{name}.yaml: name must match filename")
    for key in ("targets", "skills"):
        value = data.get(key)
        if not isinstance(value, list) or any(
            not isinstance(item, str) for item in value
        ):
            raise SkillctlError(f"profiles/{name}.yaml: {key} must be a string list")
        if len(value) != len(set(value)):
            raise SkillctlError(f"profiles/{name}.yaml: duplicate {key}")
    unknown_targets = sorted(set(data["targets"]) - set(ADAPTER_NAMES))
    if unknown_targets:
        raise SkillctlError(
            f"profiles/{name}.yaml: unknown targets: {', '.join(unknown_targets)}"
        )
    for skill_name in data["skills"]:
        skill_directory(skill_name)
    return data


def cmd_sync(args: argparse.Namespace) -> int:
    profile = load_profile(args.profile)
    targets = list(profile["targets"])
    if args.target:
        if args.target not in targets:
            raise SkillctlError(
                f"target {args.target!r} is not enabled by profile {args.profile!r}"
            )
        targets = [args.target]

    desired = set(profile["skills"])
    mode = "copy" if args.copy else "symlink"
    for target_name in targets:
        adapter = get_adapter(target_name)
        if not isinstance(adapter, FilesystemAdapter):
            raise SkillctlError(f"{target_name}: adapter does not support sync planning")
        for skill_name in profile["skills"]:
            path = skill_directory(skill_name)
            supported_targets = skill_record(path)["targets"]
            if target_name not in supported_targets:
                raise SkillctlError(
                    f"{target_name}/{skill_name}: target is not enabled in skill.yaml"
                )
            try:
                action = adapter.plan_install(path, skill_name, copy=args.copy)
                if args.dry_run:
                    verb = "would " + {
                        "installed": "install",
                        "updated": "update",
                        "skipped": "skip",
                    }[action]
                else:
                    action = adapter.install(path, skill_name, copy=args.copy)
                    verb = action
            except (OSError, ValueError) as exc:
                raise SkillctlError(f"{target_name}/{skill_name}: {exc}") from exc
            print(f"{target_name}/{skill_name}: {verb} ({mode})")

        if args.prune:
            for installed_name in sorted(set(adapter.installed()) - desired):
                if args.dry_run:
                    verb = "would remove"
                else:
                    try:
                        adapter.uninstall(installed_name)
                    except (OSError, ValueError) as exc:
                        raise SkillctlError(
                            f"{target_name}/{installed_name}: {exc}"
                        ) from exc
                    verb = "removed"
                print(f"{target_name}/{installed_name}: {verb} (prune)")
    return 0


def cmd_test(args: argparse.Namespace) -> int:
    if shutil.which("pytest") is None:
        try:
            import pytest  # noqa: F401
        except ModuleNotFoundError as exc:
            raise SkillctlError(
                "pytest is required for skill tests; install it with: "
                "python3 -m pip install pytest"
            ) from exc

    if args.name:
        candidates = [skill_directory(args.name)]
    else:
        candidates = skill_directories()
    test_dirs = [path / "tests" for path in candidates if (path / "tests").is_dir()]
    if args.name and not test_dirs:
        raise SkillctlError(f"skill has no tests directory: {args.name}")
    if not test_dirs:
        print("No skill tests found.")
        return 0
    command = [sys.executable, "-m", "pytest", *map(str, test_dirs), "-q"]
    return subprocess.run(command, cwd=REPO_ROOT, check=False).returncode


def writable_or_creatable(path: Path) -> tuple[bool, str]:
    if path.exists():
        if not path.is_dir():
            return False, "exists but is not a directory"
        writable = os.access(path, os.W_OK)
        return writable, "writable" if writable else "not writable"
    ancestor = path
    while not ancestor.exists() and ancestor != ancestor.parent:
        ancestor = ancestor.parent
    writable = ancestor.is_dir() and os.access(ancestor, os.W_OK)
    state = f"creatable via {ancestor}" if writable else f"not creatable via {ancestor}"
    return writable, state


def cmd_doctor(_args: argparse.Namespace) -> int:
    healthy = True
    version = sys.version_info
    python_ok = version >= (3, 9)
    healthy &= python_ok
    print(
        f"python: {'ok' if python_ok else 'error'} "
        f"({version.major}.{version.minor}.{version.micro})"
    )
    print(f"PyYAML: ok ({yaml.__version__})")

    for name in ADAPTER_NAMES:
        adapter = get_adapter(name)
        destination = adapter.default_dest()
        writable, state = writable_or_creatable(destination)
        healthy &= writable
        print(f"{name}: {'ok' if writable else 'error'} ({destination}; {state})")
        if destination.is_dir():
            dangling = sorted(
                path.name
                for path in destination.iterdir()
                if path.is_symlink() and not path.exists()
            )
            for skill_name in dangling:
                healthy = False
                print(f"{name}: error (dangling symlink: {skill_name})")
    return 0 if healthy else 1


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="skillctl", description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    list_parser = subparsers.add_parser("list", help="list repository skills")
    list_parser.set_defaults(func=cmd_list)

    new_parser = subparsers.add_parser("new", help="scaffold a skill")
    new_parser.add_argument("name")
    new_parser.set_defaults(func=cmd_new)

    validate_parser = subparsers.add_parser(
        "validate", help="validate skills and registry"
    )
    validate_parser.add_argument("name", nargs="?")
    validate_parser.set_defaults(func=cmd_validate)

    registry_parser = subparsers.add_parser(
        "registry", help="regenerate registry.yaml"
    )
    registry_parser.set_defaults(func=cmd_registry)

    sync_parser = subparsers.add_parser("sync", help="sync a profile to adapters")
    sync_parser.add_argument("--profile", required=True)
    sync_parser.add_argument("--target", choices=ADAPTER_NAMES)
    sync_parser.add_argument("--copy", action="store_true")
    sync_parser.add_argument("--dry-run", action="store_true")
    sync_parser.add_argument("--prune", action="store_true")
    sync_parser.set_defaults(func=cmd_sync)

    test_parser = subparsers.add_parser("test", help="run skill-local pytest suites")
    test_parser.add_argument("name", nargs="?")
    test_parser.set_defaults(func=cmd_test)

    doctor_parser = subparsers.add_parser(
        "doctor", help="check Python and adapter destinations"
    )
    doctor_parser.set_defaults(func=cmd_doctor)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args))
    except (SkillctlError, KeyError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())

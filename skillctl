#!/usr/bin/env python3
"""Thin entry point for the Skobal command-line interface."""

try:
    import yaml  # noqa: F401
except ModuleNotFoundError:
    print(
        "skillctl requires PyYAML. Install it with: "
        "python3 -m pip install PyYAML",
        file=__import__("sys").stderr,
    )
    raise SystemExit(2)

from skobal.cli import main


if __name__ == "__main__":
    raise SystemExit(main())
